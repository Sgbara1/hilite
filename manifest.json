{
  "manifest_version": 3,
  "name": "Hilite — Web Highlighter",
  "version": "1.0.0",
  "description": "Self-hosted Glasp alternative. Highlight the web in 4 colors, add notes and tags, and export everything as Markdown. 100% local, no account.",
  "permissions": ["storage", "activeTab", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/anchor.js", "src/export.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Hilite"
  },
  "options_page": "src/library.html",
  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Toggle the Hilite sidebar"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
